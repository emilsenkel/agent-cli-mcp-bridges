# Which agent CLI to expose. One of: claude, hermes, grok, custom.
AGENT_PROFILE=claude

# Override the binary (otherwise: claude, hermes, or grok on PATH).
# AGENT_BIN=claude

# Default working directory for ask_agent when the caller does not pass cwd.
PROJECT_ROOT=.

# HTTP bind. Default loopback.
# MCP_HOST=127.0.0.1
# MCP_PORT=8790

# Bearer token. Prefer a file (mode 600) over putting a value in the environment.
# MCP_TOKEN_FILE=~/.config/agent-cli-mcp/token
# MCP_TOKEN=

# Optional webhook for the `notify` tool (JSON POST { "text": "..." }).
# Leave unset to disable the tool.
# WEBHOOK_URL=

# Default timeout for a headless agent run, in seconds.
# AGENT_TIMEOUT_SEC=300
